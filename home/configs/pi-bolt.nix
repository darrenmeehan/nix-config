{ pkgs, ... }:
let
  # The extension set, settings and guardrails file shared with dev-1 — see
  # pkgs/pi-bolt/pi-config.nix. This machine is the one with curam.
  piConfig = import ../../pkgs/pi-bolt/pi-config.nix { inherit pkgs; };
  # `--jit on`: opensec-pi-fff's `watch()` reaches its native library through
  # bun:ffi, whose calls are generated by the JIT (its search and grep fall back
  # to ffi-rs without one), and the extensions left at run time are compiled by
  # it instead of interpreted. Pi and the compiled-in extensions are AOT machine
  # code either way; the cost is the JIT's code cache and threads.
  # cpu = "native": compile Pi and the extensions for this CPU (AVX2 class)
  # instead of any x86-64. This build is only used on this machine.
  piBolt = (pkgs.pi-bolt.withExtensions piConfig.extensions).override {
    jitSupport = true;
    cpu = "native";
  };
in
{
  # The engine the driver spawns: `curam-membrane` on PATH is discovery rule 2,
  # ahead of the ~/code workspace-build fallbacks, so a missing engine is a
  # broken install rather than a silently older binary.
  home.packages = [ piBolt pkgs.curam-membrane ];

  # Shared settings. `force` matters: they are regular files on this machine
  # already, so a plain symlink would refuse to replace them.
  home.file.".pi/agent/settings.json" = {
    source = (pkgs.formats.json { }).generate "settings.json" piConfig.settings;
    force = true;
  };

  # Guardrails' global config.
  home.file.".pi/agent/extensions/guardrails.json" = {
    source = (pkgs.formats.json { }).generate "guardrails.json" piConfig.guardrails;
    force = true;
  };
}
