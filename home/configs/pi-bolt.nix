{ pkgs, ... }:
let
  # The extensions installed on this machine, compiled into the executable
  # instead of loaded from their files at run time. Each is named in the
  # manifest, so pi lists it as a built-in extension (`builtin:<name>`) and a
  # run-time copy of the same extension replaces it rather than registering its
  # tools twice. Herdr's integration file is not here: pi-bolt has Herdr support
  # of its own and skips that file, while `pi` still finds it in
  # ~/.pi/agent/extensions.
  #
  # Left out because they read their own files at run time, which a compiled
  # executable does not have (import.meta points into the executable, `$bunfs`):
  # bigpowers scans <package>/skills/ at load; opensec-pi-fff, opensec-pi-todo
  # and opensec-pi-subagents are thin entries that nativeRequire ./core.cjs
  # beside themselves, on every factory call, so /reload and upgrades work (the
  # subagents one also discovers .pi/agents/*.md and ~/.pi/agent/agents/*.md at
  # run time).
  #
  # Left out for other reasons, also loading from their files as before:
  # pi-agent-browser-native, whose entry module's top-level bytecode is over
  # pi-bolt's AOT candidate limit; @dietrichgebert/ponytail, which imports
  # ../hooks/ponytail-config.js from its own folder; and
  # @plannotator/pi-extension, whose diagram engine imports node-canvas, a native
  # addon nothing here builds.
  #
  # The curam-membrane driver is here: it is a flake input now (a store path, not
  # a checkout in ~/code), so there is something to compile, and it reads no
  # files of its own at run time — only the engine's path, which it finds on PATH.
  #
  # A compiled-in extension loads whether or not it is enabled, so anything that
  # cannot be compiled in fails the start for every session, not just its own.
  extensions = [
    "${pkgs.pi-extensions}/node_modules/@aliou/pi-guardrails"
    "${pkgs.pi-extensions}/node_modules/@heyhuynhgiabuu/pi-diff"
    "${pkgs.pi-extensions}/node_modules/@melihmucuk/leash"
    "${pkgs.pi-extensions}/node_modules/@mjasnikovs/pi-task"
    "${pkgs.curam-membrane-driver}/drivers/pi"
  ];
  # Pi's package list, untouched: `pi` loads all nine from their files.
  piPackages = [
    "npm:bigpowers"
    "npm:@dietrichgebert/ponytail"
    "npm:@plannotator/pi-extension"
    "npm:@mjasnikovs/pi-task"
    "npm:pi-agent-browser-native"
    "npm:@heyhuynhgiabuu/pi-diff"
    "npm:@aliou/pi-guardrails"
    "npm:@melihmucuk/leash"
    "${pkgs.curam-membrane-driver}/drivers/pi"
  ];

  # `piBolt.packages` is an overlay on that list: an exclusion takes out an
  # extension compiled into the executable (a run-time copy would replace it, and
  # be interpreted), and an addition brings in one that only pi-bolt has. `pi`
  # ignores this section.
  # opensec-pi-subagents is pi-bolt-only, like opensec-pi-todo and
  # opensec-pi-fff: its public build is the Bun one (`engines.bun`, dist-bun/),
  # which is what pi-bolt runs.
  piBoltPackages = [
    "-npm:@mjasnikovs/pi-task"
    "-npm:@heyhuynhgiabuu/pi-diff"
    "-npm:@aliou/pi-guardrails"
    "-npm:@melihmucuk/leash"
    "-${pkgs.curam-membrane-driver}/drivers/pi"
    "npm:opensec-pi-todo"
    "npm:opensec-pi-fff"
    "npm:opensec-pi-subagents"
  ];
  # `--jit on`: opensec-pi-fff's `watch()` reaches its native library through
  # bun:ffi, whose calls are generated by the JIT (its search and grep fall back
  # to ffi-rs without one), and the eight extensions left at run time are
  # compiled by it instead of interpreted. Pi and the compiled-in extensions are
  # AOT machine code either way; the cost is the JIT's code cache and threads.
  # cpu = "native": compile Pi and the extensions for this CPU (AVX2 class)
  # instead of any x86-64. This build is only used on this machine.
  piBolt = (pkgs.pi-bolt.withExtensions extensions).override {
    jitSupport = true;
    cpu = "native";
  };
in
{
  # The engine the driver spawns: `curam-membrane` on PATH is discovery rule 2,
  # ahead of the ~/code workspace-build fallbacks, so a missing engine is a
  # broken install rather than a silently older binary.
  home.packages = [ piBolt pkgs.curam-membrane ];

  # Pi's settings, shared by `pi` and `pi-bolt`. A store file is read-only, so
  # neither can save settings changes from inside a session (`/model` and the
  # like show the change but do not keep it): edit this and switch.
  # `lastChangelogVersion` and `extensionChangelogVersions` are only bookkeeping
  # and are left to fail.
  home.file.".pi/agent/settings.json" = {
    source = (pkgs.formats.json { }).generate "settings.json" {
      defaultModel = "deepseek/deepseek-v4.1-flash-1017";
      defaultProvider = "openrouter";
      defaultThinkingLevel = "high";
      hideThinkingBlock = true;
      theme = "dark";
      enableInstallTelemetry = false;
      packages = piPackages;
      piBolt = {
        packages = piBoltPackages;
        packagesOverlay = true;
      };
    };
    # It is a regular file on this machine already.
    force = true;
  };

  # Guardrails' global config — the same file `pi` loads from npm and `pi-bolt`
  # loads compiled in. `gh` writes to GitHub are auto-denied: no prompt, and
  # `terminate` ends the turn so the agent asks instead of retrying. Reads
  # (`gh pr view`/`diff`/`list`/`checks`) and `git` are untouched. `gh api` is
  # denied wholesale, since it is the escape hatch around the verb list.
  #
  # A denylist over the literal command, not a sandbox: `curl` to
  # api.github.com, or any other client, still gets through.
  #
  # `version` is the @aliou/pi-guardrails release this file is written for
  # (pkgs/pi-extensions/npm/package-lock.json). Without it guardrails runs its
  # migrations on every load, stamps the version and tries to save the result —
  # into a read-only store file, so it fails with EACCES and repeats the next
  # session. Bump it when the extension's own migrations change this file.
  home.file.".pi/agent/extensions/guardrails.json" = {
    source = (pkgs.formats.json { }).generate "guardrails.json" {
      version = "0.23.0";
      permissionGate.autoDenyPatterns = [
        {
          pattern = "\\bgh\\s+(pr|issue|release|repo|secret|variable|workflow|gist|label|ruleset|cache|project|discussion)\\s+(create|edit|merge|comment|close|reopen|ready|review|delete|set|run|sync|upload|download|rename|transfer|pin|unpin|lock|unlock|update|add|remove|clear)\\b";
          regex = true;
          terminate = true;
          description = "GitHub write through the gh CLI. Ask the user to run it.";
        }
        {
          pattern = "\\bgh\\s+api\\b";
          regex = true;
          terminate = true;
          description = "gh api is the bypass around the gh write gate. Ask the user to run it.";
        }
      ];
    };
    force = true;
  };
}
